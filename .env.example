# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real keys.

# OpenAI key used by the chatbot API route (server-side only)
OPENAI_API_KEY=

# Optional: override the chat model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Web3Forms access key for the contact form — get one at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
