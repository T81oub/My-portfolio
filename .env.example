# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real keys.

# --- Chat model -------------------------------------------------------------
# Set at least one provider. If MISTRAL_API_KEY is set, Mistral is used;
# otherwise the chatbot falls back to OpenAI.

# Mistral (free tier available) — get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Optional: defaults to mistral-small-latest
MISTRAL_MODEL=mistral-small-latest

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Contact form -----------------------------------------------------------
# Web3Forms access key — get one at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
